# ==============================================================================
# RailPulse Enterprise — Environment Template (.env.example)
# Copy this file to .env before running in local or production environments:
#   cp .env.example .env
# ==============================================================================

# --- Application Identity & Metadata ---
VITE_APP_TITLE="RailPulse Enterprise"
VITE_APP_NAME_FA="سامانه جامع مدیریت حمل‌ونقل ریلی و فروش بلیط"
VITE_APP_VERSION="2.4.0"
VITE_APP_ENV="development"
VITE_REPOSITORY_URL="https://github.com/Mahdias1383/management_system"

# --- Localization, Theme & Currency Engine ---
# Supported locales: "fa" (Persian RTL / Rial IRR) | "en" (English LTR / USD $)
VITE_DEFAULT_LOCALE="fa"
# Supported themes: "dark" | "light"
VITE_DEFAULT_THEME="dark"
# Nominal ledger conversion rate used by formatCurrency & toUsdValue (100,000 IRR = $1.00 USD)
VITE_USD_EXCHANGE_RATE="100000"

# --- Storage, Session & Schema v1->v2 Migration Engine ---
VITE_STORAGE_KEY="railpulse_enterprise_db_v2_irr"
VITE_SESSION_STORAGE_KEY="railpulse_active_session_v2"
VITE_ENABLE_AUTO_MIGRATION="true"

# --- Security, RBAC & Audit Telemetry ---
VITE_SESSION_TTL_HOURS="8"
VITE_ENABLE_AUDIT_LOG="true"

# --- Railway Operations, Booking & Collision Physics Engine ---
# Mandatory headway safety buffer in minutes enforced by checkAccident (5 minutes)
VITE_COLLISION_SAFETY_BUFFER_MINUTES="5"
# Default intermediate station dwell time in minutes (20 minutes)
VITE_DEFAULT_STATION_DWELL_MINUTES="20"
# Prefix for issued passenger PNR reservation codes (e.g., RP-89412)
VITE_PNR_PREFIX="RP"
